APP_NAME="Slim 4 API"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8008

DB_ENABLED=true
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=slim_api
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

LOG_CHANNEL=default
LOG_LEVEL=debug
API_PREFIX=/api
API_VERSION=v1
JWT_SECRET=your-secret-key
JWT_TTL=3600
