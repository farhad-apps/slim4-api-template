{
    "name": "farhad-apps/slim4-api-template",
    "description": "A clean and scalable API structure with Slim 4, Illuminate ORM, and Validation",
    "type": "project",
    "require": {
        "php": "^8.0",
        "slim/slim": "^4.11",
        "slim/psr7": "^1.6",
        "illuminate/database": "^10.0",
        "illuminate/validation": "^10.0",
        "vlucas/phpdotenv": "^5.5",
        "php-di/php-di": "^7.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    }
}
